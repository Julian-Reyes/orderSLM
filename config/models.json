{
  "_comment": "Models as config (ported from AgentDesk server/config/models.json). Prices are micro-USD per 1M tokens, verified on the date in price_verified against price_source (docs/COSTS.md). Each model has reasoning variants (request fields merged into the body); the config id is provider/model@variant, the first variant is the lowest setting and the one marked provider_default matches sending nothing. rpm is OrderSLM's own pacing, below every provider limit.",
  "models": [
    {
      "provider": "openai",
      "model": "gpt-6-luna",
      "api": "openai_chat",
      "base_url": "https://api.openai.com/v1",
      "key_env": "OPENAI_API_KEY",
      "structured_output": "json_schema",
      "max_tokens_param": "max_completion_tokens",
      "variants": [
        {"name": "none", "extra_body": {"reasoning_effort": "none"}},
        {"name": "low", "extra_body": {"reasoning_effort": "low"}},
        {"name": "medium", "extra_body": {"reasoning_effort": "medium"}, "provider_default": true}
      ],
      "rpm": 60,
      "price": {"input": 100000, "cached_input": 10000, "cache_write": 125000, "output": 500000},
      "long_context": {"threshold_input_tokens": 272000, "price": null},
      "price_verified": "2026-10-16",
      "price_source": "https://developers.openai.com/api/docs/pricing"
    },
    {
      "provider": "anthropic",
      "model": "claude-haiku-5-5",
      "api": "anthropic_messages",
      "base_url": "https://api.anthropic.com/v1",
      "key_env": "ANTHROPIC_API_KEY",
      "structured_output": "json_object",
      "max_tokens_param": "max_tokens",
      "variants": [
        {"name": "off-low", "extra_body": {"thinking": {"type": "disabled"}, "output_config": {"effort": "low"}}},
        {"name": "off-medium", "extra_body": {"thinking": {"type": "disabled"}, "output_config": {"effort": "medium"}}},
        {"name": "on-low", "extra_body": {"thinking": {"type": "adaptive"}, "output_config": {"effort": "low"}}},
        {"name": "on-medium", "extra_body": {"thinking": {"type": "adaptive"}, "output_config": {"effort": "medium"}}, "provider_default": true}
      ],
      "rpm": 60,
      "price": {"input": 100000, "cached_input": 10000, "cache_write": 125000, "output": 500000},
      "long_context": {
        "threshold_input_tokens": 100000,
        "price": {"input": 500000, "cached_input": 50000, "cache_write": 625000, "output": 2500000}
      },
      "price_verified": "2026-10-16",
      "price_source": "https://platform.claude.com/docs/en/about-claude/pricing"
    },
    {
      "provider": "google",
      "model": "gemini-3.1-flash-lite",
      "api": "openai_chat",
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
      "key_env": "GEMINI_API_KEY",
      "structured_output": "json_schema",
      "max_tokens_param": "max_tokens",
      "variants": [
        {"name": "minimal", "extra_body": {"reasoning_effort": "minimal"}},
        {"name": "default", "extra_body": {}, "provider_default": true}
      ],
      "rpm": 60,
      "price": {"input": 250000, "output": 1500000},
      "price_verified": "2026-10-16",
      "price_source": "https://ai.google.dev/gemini-api/docs/pricing"
    },
    {
      "provider": "deepseek",
      "model": "deepseek-flash",
      "api": "openai_chat",
      "base_url": "https://api.deepseek.com",
      "key_env": "DEEPSEEK_API_KEY",
      "structured_output": "json_object",
      "max_tokens_param": "max_tokens",
      "variants": [
        {"name": "none", "extra_body": {"reasoning_effort": "none"}},
        {"name": "low", "extra_body": {"reasoning_effort": "low"}},
        {"name": "high", "extra_body": {"reasoning_effort": "high"}, "provider_default": true}
      ],
      "rpm": 60,
      "price": {"input": 300000, "cached_input": 6000, "output": 1200000},
      "off_peak": {
        "price": {"input": 150000, "cached_input": 3000, "output": 600000},
        "peak_windows_utc_weekdays": [[1, 4], [6, 10]]
      },
      "price_verified": "2026-10-16",
      "price_source": "https://api-docs.deepseek.com/quick_start/pricing"
    }
  ]
}
