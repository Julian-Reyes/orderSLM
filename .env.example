# Copy to .env. Keys are read only by provider clients (M3+); tests never need them.
# Use OrderSLM-specific keys/projects with spend caps, separate from AgentDesk's (spec §15).
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
JEV_API_KEY=

# Record/replay cache: off | record | replay | refresh (M3+)
LLM_CACHE=record

# Set only for final evaluation runs on the sealed test set, to a reason, e.g. "final-eval M6".
# ORDERSLM_UNSEAL_TEST=
