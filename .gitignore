.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.env
.env.*
!.env.example
.DS_Store

# Record/replay cache of provider responses (M3+). Large and regenerable; eval outputs in runs/ are committed.
.llm-cache/

# Third-party datasets (e.g. PIZZA, CC-BY-NC-4.0: no redistribution). Only download/convert scripts are committed.
data/external/

# Model weights, adapters and quantized files (M5+) go to Hugging Face, not git.
models/
*.gguf
*.safetensors

# Frontend build output and dependencies (web/package-lock.json is committed).
web/node_modules/
web/dist/

# Kaggle jobs: staged dataset uploads and raw kernel output (imported into runs/ by each job's import step).
kaggle/*/upload/
kaggle/*/output/
